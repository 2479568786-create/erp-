{
  "version": 1,
  "description": "文案越界规则（R7）：品牌词/正品宣称/促销词/联系方式/中文乱码/长度。品牌白名单与自有品牌在运行时按商品补齐。",
  "rules": [
    {
      "code": "BRAND",
      "severity": "warning",
      "fields": [
        "title",
        "description",
        "tags"
      ],
      "description": "出现非本商品的品牌名（无品牌白名单除外）",
      "fix": "删除标签/文案中的品牌词，或确认商品真实品牌后再填"
    },
    {
      "code": "ORIGINAL_CLAIM",
      "severity": "warning",
      "fields": [
        "title",
        "description",
        "tags"
      ],
      "regex": "(?i)(оригинал\\w*|100\\s*%\\s*оригинал|原装正品|正品保证)"
    },
    {
      "code": "PROMO",
      "severity": "warning",
      "fields": [
        "title",
        "description",
        "tags"
      ],
      "regex": "(?i)(скидк\\w*|акци\\w*|распродаж\\w*|дешев\\w*|выгодн\\w*|эконом\\w*|лучш\\w*\\s*[_\\-\\s]?\\s*цена|хит\\w*\\s*[_\\-\\s]?\\s*продаж|подарок|бесплатн\\w*|новинк\\w*|супер[_\\-\\s]?цена)"
    },
    {
      "code": "CONTACT",
      "severity": "warning",
      "fields": [
        "title",
        "description",
        "tags"
      ],
      "regex": "(?i)(https?://|tel:|whatsapp|telegram|t\\.me/|@[A-Za-z0-9_]{4,})"
    },
    {
      "code": "CJK",
      "severity": "warning",
      "fields": [
        "title",
        "description",
        "tags"
      ],
      "regex": "[\\u4e00-\\u9fff]+",
      "description": "俄语 listing 中出现中文"
    }
  ],
  "limits": {
    "title_max_chars": 200,
    "tags_max_count": 30,
    "tag_max_chars": 30
  },
  "brand_whitelist": [
    "无品牌",
    "нет бренда",
    "no brand",
    "none",
    "copy",
    "без бренда"
  ],
  "tags_attribute_id": 23171,
  "brand_attribute_ids": [
    85
  ],
